<!DOCTYPE html>
<html lang="en" data-theme="{{themeMode}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {{#if faviconUrl}}<link rel="icon" href="{{faviconUrl}}" type="image/png" />
  <link rel="apple-touch-icon" href="{{faviconUrl}}" />{{/if}}
  <title>{{pageTitle}}</title>
  <meta name="description" content="{{metaDescription}}" />
  {{#if metaKeywords}}<meta name="keywords" content="{{metaKeywords}}" />{{/if}}
  <meta name="robots" content="{{robots}}" />
  {{#if canonicalUrl}}<link rel="canonical" href="{{canonicalUrl}}" />{{/if}}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ogTitle}}" />
  <meta property="og:description" content="{{ogDescription}}" />
  {{#if ogImageUrl}}<meta property="og:image" content="{{ogImageUrl}}" />{{/if}}
  <meta name="twitter:card" content="{{twitterCard}}" />
  <meta name="twitter:title" content="{{ogTitle}}" />
  <meta name="twitter:description" content="{{ogDescription}}" />
  {{#if ogImageUrl}}<meta name="twitter:image" content="{{ogImageUrl}}" />{{/if}}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="./styles.css" />
  <style>:root { --accent: {{primaryColor}}; }</style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <nav class="site-nav" aria-label="Primary">
    <div class="site-nav-inner">
      <a class="nav-brand" href="#home">{{shortName}}</a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav-menu">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
        <span class="visually-hidden">Open menu</span>
      </button>
      <div class="nav-links" id="site-nav-menu">
        <a href="#home">Home</a>
        {{#if bio}}<a href="#about">About</a>{{else}}{{#if avatarUrl}}<a href="#about">About</a>{{else}}{{#if location}}<a href="#about">About</a>{{/if}}{{/if}}{{/if}}
        {{#if hasExperience}}<a href="#experience">Work</a>{{else}}{{#if hasEducation}}<a href="#education">Work</a>{{/if}}{{/if}}
        {{#if hasProjects}}<a href="#projects">Projects</a>{{/if}}
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>
  <div class="page">
    <header class="hero" id="home">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-inner">
        <p class="hello">Hi! I am</p>
        <h1>{{fullName}}</h1>
        {{#if headline}}<p class="headline">{{headline}}</p>{{/if}}
        <div class="hero-actions">
          {{#if email}}<a class="cta" href="mailto:{{email}}">Contact Me</a>{{/if}}
          <nav class="socials" aria-label="Social links">
          <div class="social-icons-row">{{#if socials.github}}<a class="social-btn" href="{{socials.github}}" rel="noopener noreferrer" target="_blank" title="GitHub" aria-label="GitHub"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>{{/if}}
            {{#if socials.linkedin}}<a class="social-btn" href="{{socials.linkedin}}" rel="noopener noreferrer" target="_blank" title="LinkedIn" aria-label="LinkedIn"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>{{/if}}
            {{#if socials.website}}<a class="social-btn" href="{{socials.website}}" rel="noopener noreferrer" target="_blank" title="Website" aria-label="Website"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg></a>{{/if}}
            {{#if socials.twitter}}<a class="social-btn" href="{{socials.twitter}}" rel="noopener noreferrer" target="_blank" title="Twitter / X" aria-label="Twitter / X"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.995-9.12L.254 2.25H8.08l4.413 5.887L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg></a>{{/if}}{{#if socials.facebook}}<a class="social-btn" href="{{socials.facebook}}" rel="noopener noreferrer" target="_blank" title="Facebook" aria-label="Facebook"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>{{/if}}{{#if socials.tiktok}}<a class="social-btn" href="{{socials.tiktok}}" rel="noopener noreferrer" target="_blank" title="TikTok" aria-label="TikTok"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.95-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></a>{{/if}}{{#if socials.youtube}}<a class="social-btn" href="{{socials.youtube}}" rel="noopener noreferrer" target="_blank" title="YouTube" aria-label="YouTube"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>{{/if}}{{#if socials.instagram}}<a class="social-btn" href="{{socials.instagram}}" rel="noopener noreferrer" target="_blank" title="Instagram" aria-label="Instagram"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>{{/if}}{{#if socials.behance}}<a class="social-btn" href="{{socials.behance}}" rel="noopener noreferrer" target="_blank" title="Behance" aria-label="Behance"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.963 1.782 5.375 4.426.078.506.109 1.188.095 2.14H13.96c.13 3.211 3.483 3.312 4.59 2.049h3.176zm-7.032-4.187h4.198c-.093-1.688-1.298-2.486-2.216-2.486-.1 0-2.072.281-1.982 2.486zM6.858 21.046H0V5.005h6.966c5.528.047 6.613 4.196 3.203 6.4 4.113 1.19 4.257 7.338-3.311 9.641zm-.859-12.648H2.859v3.598h2.357c1.898-.034 2.826-.918 2.826-1.85-.001-.902-.764-1.706-2.043-1.748zM2.859 15.407h2.934c2.217-.022 2.734-1.514 2.734-2.277 0-1.544-1.421-2.363-3.029-2.363H2.859v4.64z"/></svg></a>{{/if}}{{#if socials.dribbble}}<a class="social-btn" href="{{socials.dribbble}}" rel="noopener noreferrer" target="_blank" title="Dribbble" aria-label="Dribbble"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M12 24C5.385 24 0 18.615 0 12S5.385 0 12 0s12 5.385 12 12-5.385 12-12 12zm10.12-10.358c-.35-.11-3.17-.953-6.216-.438 1.316 3.611 1.853 6.59 1.945 7.193 2.237-1.511 3.82-3.838 4.271-6.754zM16.56 21.607c-.129-.749-.727-4.126-2.122-7.967l-.063.021c-5.625 1.917-7.565 5.704-7.74 6.005.966.848 2.185 1.481 3.541 1.704a10.02 10.02 0 006.384.237zM5.974 19.682c.226-.388 2.446-4.066 7.08-6.088.155-.054.315-.1.475-.145-1.603-2.911-3.345-5.337-3.455-5.485a9.98 9.98 0 00-4.1 11.718zM3.066 12.001c0-.985.18-1.948.514-2.857.526.11 4.326.889 8.415 2.956.093-.19.185-.38.287-.576.31-.585.641-1.162.98-1.724-4.58-2.282-6.697-5.445-6.917-5.782A9.966 9.966 0 003.066 12zM12.32 2.613c.877 1.16 3.047 4.238 5.43 6.82.802-1.198 1.508-2.45 2.087-3.74A9.987 9.987 0 0012.32 2.613zm8.57 5.127c-.618 1.017-1.36 2.02-2.196 2.98 2.96.855 5.91.986 6.209 1.01a9.986 9.986 0 00-4.013-3.99z"/></svg></a>{{/if}}
            {{#if phone}}<a class="social-btn" href="{{phoneHref}}" title="{{phone}}" aria-label="Call {{phone}}"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M6.62 10.79a15.15 15.15 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.4 21 3 13.6 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg></a>{{/if}}</div></nav>
        </div>
        <a class="scroll-cue" href="#about"><span>Scroll for more</span><span class="scroll-arrow" aria-hidden="true"></span></a>
      </div>
    </header>

    {{#if hasSkills}}
    <div class="skill-marquee" aria-hidden="true">
      <div class="skill-track">
        {{#each skills}}<span>{{this}}</span>{{/each}}
        {{#each skills}}<span>{{this}}</span>{{/each}}
      </div>
    </div>
    {{/if}}

    <main id="main">
      {{#if bio}}
      <section class="section about-split" id="about">
        {{#if avatarUrl}}
        <div class="about-media">
          <img class="about-photo" src="{{avatarUrl}}" alt="{{fullName}}" width="420" height="520" />
        </div>
        {{/if}}
        <div class="about-copy">
          <p class="section-kicker">{{sectionTitles.about}}</p>
          <h2>About Me</h2>
          {{#if location}}<p class="based">Based in <strong>{{location}}</strong></p>{{/if}}
          <div class="md-content lead">{{{bioHtml}}}</div>
          {{#if hasSkills}}
          <ul class="chips">{{#each skills}}<li>{{this}}</li>{{/each}}</ul>
          {{/if}}
        </div>
      </section>
      {{else}}
        {{#if avatarUrl}}
        <section class="section about-split" id="about">
          <div class="about-media">
            <img class="about-photo" src="{{avatarUrl}}" alt="{{fullName}}" width="420" height="520" />
          </div>
          <div class="about-copy">
            <p class="section-kicker">{{sectionTitles.about}}</p>
            <h2>About Me</h2>
            {{#if location}}<p class="based">Based in <strong>{{location}}</strong></p>{{/if}}
            {{#if hasSkills}}
            <ul class="chips">{{#each skills}}<li>{{this}}</li>{{/each}}</ul>
            {{/if}}
          </div>
        </section>
        {{else}}
          {{#if location}}
          <section class="section about-split" id="about">
            <div class="about-copy">
              <p class="section-kicker">{{sectionTitles.about}}</p>
              <h2>About Me</h2>
              <p class="based">Based in <strong>{{location}}</strong></p>
              {{#if hasSkills}}
              <ul class="chips">{{#each skills}}<li>{{this}}</li>{{/each}}</ul>
              {{/if}}
            </div>
          </section>
          {{/if}}
        {{/if}}
      {{/if}}

      {{#if hasExperience}}
      <section class="section" id="experience">
        <div class="section-title"><h2>{{sectionTitles.experience}}</h2></div>
        <div class="timeline">
          {{#each experience}}
          <article class="timeline-item">
            <div class="timeline-rail" aria-hidden="true"><span class="timeline-dot"></span></div>
            <div class="timeline-body">
              <div class="timeline-head">
                {{#if logoUrl}}<img class="timeline-logo" src="{{logoUrl}}" alt="" width="40" height="40" loading="lazy" />{{/if}}
                <div class="timeline-copy">
                  <h3>{{#if role}}{{role}}{{else}}{{company}}{{/if}}</h3>
                  {{#if role}}{{#if company}}
                  <p class="timeline-org"><span>{{company}}</span>{{#if location}}<span class="timeline-sep" aria-hidden="true">·</span><span class="timeline-loc">{{location}}</span>{{/if}}</p>
                  {{else}}{{#if location}}<p class="timeline-org"><span class="timeline-loc">{{location}}</span></p>{{/if}}{{/if}}
                  {{else}}{{#if location}}<p class="timeline-org"><span class="timeline-loc">{{location}}</span></p>{{/if}}{{/if}}
                  {{#if startDate}}<p class="timeline-dates">{{startDate}}{{#if endDate}} — {{endDate}}{{/if}}</p>{{else}}{{#if endDate}}<p class="timeline-dates">{{endDate}}</p>{{/if}}{{/if}}
                </div>
              </div>
              {{#if description}}<div class="md-content">{{{descriptionHtml}}}</div>{{/if}}
            </div>
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if hasEducation}}
      <section class="section" id="education">
        <div class="section-title"><h2>{{sectionTitles.education}}</h2></div>
        <div class="timeline">
          {{#each education}}
          <article class="timeline-item">
            <div class="timeline-rail" aria-hidden="true"><span class="timeline-dot"></span></div>
            <div class="timeline-body">
              <div class="timeline-head">
                <div class="timeline-copy">
                  <h3>{{#if degree}}{{degree}}{{else}}{{school}}{{/if}}</h3>
                  {{#if degree}}{{#if school}}<p class="timeline-org">{{school}}</p>{{/if}}{{/if}}
                  {{#if field}}<p class="timeline-field">{{field}}</p>{{/if}}
                  {{#if startDate}}<p class="timeline-dates">{{startDate}}{{#if endDate}} — {{endDate}}{{/if}}</p>{{else}}{{#if endDate}}<p class="timeline-dates">{{endDate}}</p>{{/if}}{{/if}}
                </div>
              </div>
              {{#if description}}<div class="md-content">{{{descriptionHtml}}}</div>{{/if}}
            </div>
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if hasProjects}}
      <section class="section" id="projects">
        <div class="section-title">
          <p class="section-kicker">Selected</p>
          <h2>{{sectionTitles.projects}}</h2>
        </div>
        <div class="projects">
          {{#each projects}}
          <article class="card">
            {{#if imageUrl}}<img class="project-image" src="{{imageUrl}}" alt="{{title}}" loading="lazy" />{{/if}}
            <div class="card-body">
              <h3>{{title}}</h3>
              {{#if description}}<div class="md-content">{{{descriptionHtml}}}</div>{{/if}}
              {{#if tech.length}}
              <ul class="chips small">{{#each tech}}<li>{{this}}</li>{{/each}}</ul>
              {{/if}}
              {{#if link}}<a class="link" href="{{link}}" rel="noopener noreferrer" target="_blank">View work</a>{{/if}}
            </div>
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      <section class="section connect" id="contact">
        <p class="section-kicker">Let's connect</p>
        <h2>Say Hi!</h2>
        {{#if email}}<a class="connect-mail" href="mailto:{{email}}">{{email}}</a>{{/if}}
